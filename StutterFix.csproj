<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>StutterFix</AssemblyName>
    <RootNamespace>StutterFix</RootNamespace>
    <DefineConstants>$(DefineConstants);GPUDECO</DefineConstants>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/optimization/HitMeterDirectCheck/**/bin/**;tools/optimization/HitMeterDirectCheck/**/obj/**</DefaultItemExcludes>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0162</NoWarn>  <!-- Edition.Dev 상수로 막힌 코드 경고 -->
  </PropertyGroup>

  <!-- 기본은 개발자용(DEV). 플레이어용은 dotnet build -p:Edition=Player 로 bin/Player 에 따로 만든다. -->
  <PropertyGroup Condition="'$(Edition)' != 'Player'">
    <DefineConstants>$(DefineConstants);DEV</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == 'Player'">
    <OutputPath>bin/Player/</OutputPath>
    <IntermediateOutputPath>obj/Player/</IntermediateOutputPath>
  </PropertyGroup>
  <!-- MelonLoader 빌드: dotnet build -p:Edition=Player -p:Loader=Melon 로 bin/Melon 에 만든다. 소스는 같고 melon/ 의 UMM 흉내와 진입점만 더한다. -->
  <PropertyGroup Condition="'$(Loader)' == 'Melon'">
    <MelonGamePath Condition="'$(MelonGamePath)' == ''">D:/clientmine/A Dance of Fire and Ice</MelonGamePath>
    <DefineConstants>$(DefineConstants);MELON</DefineConstants>
    <OutputPath>bin/Melon/</OutputPath>
    <IntermediateOutputPath>obj/Melon/</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Loader)' == 'Melon'">
    <Compile Include="melon/UmmShim.cs" />
    <Compile Include="melon/MelonEntry.cs" />
  </ItemGroup>
  <!-- (측정용, 배포 안 함) 플레이어용에 자동 시험만 더한다: dotnet build -p:Edition=Player -p:AutoTestBuild=1 -->
  <PropertyGroup Condition="'$(AutoTestBuild)' == '1'">
    <DefineConstants>$(DefineConstants);AUTOTEST</DefineConstants>
    <OutputPath>bin/PlayerAuto/</OutputPath>
    <IntermediateOutputPath>obj/PlayerAuto/</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <!-- 소스 진행값·이징값을 슬롯 배열에 둔다(2026-11-12 기본 켬: 일시정지 픽셀 차이 0, 이징 재계산 일치 1835/1835) -->
    <DefineConstants>$(DefineConstants);CLOCK_ARRAYS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AutoTestBuild)' == '1' And '$(ClockArraysBuild)' == '1'">
    <DefineConstants>$(DefineConstants);CLOCK_ARRAYS</DefineConstants>
    <OutputPath>bin/PlayerAutoClockArrays/</OutputPath>
    <IntermediateOutputPath>obj/PlayerAutoClockArrays/</IntermediateOutputPath>
  </PropertyGroup>

