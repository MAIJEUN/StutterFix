<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>StutterFix</AssemblyName>
    <RootNamespace>StutterFix</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0162</NoWarn>  <!-- Edition.Dev 상수로 막힌 코드 경고 -->
  </PropertyGroup>

  <!-- 기본은 개발자용(DEV). 플레이어용은 dotnet build -p:Edition=Player 로 bin/Player 에 따로 만든다. -->
  <PropertyGroup Condition="'$(Edition)' != 'Player'">
    <DefineConstants>$(DefineConstants);DEV</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == 'Player'">
    <OutputPath>bin/Player/</OutputPath>
    <IntermediateOutputPath>obj/Player/</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="StutterFix.cs" />
    <Compile Include="Edition.cs" />
    <Compile Include="SettingsWindow.cs" />
    <Compile Include="Profiler.cs" />
    <Compile Include="SceneScan.cs" />
    <Compile Include="AbTest.cs" />
    <Compile Include="LoopProfiler.cs" />
    <Compile Include="GcControl.cs" />
    <Compile Include="Hitch.cs" />
    <Compile Include="ModWatch.cs" />
    <Compile Include="AllocScan.cs" />
    <Compile Include="TextFix.cs" />
    <Compile Include="PhaseWatch.cs" />
    <Compile Include="SlowScan.cs" />
    <Compile Include="EffectScan.cs" />
    <Compile Include="EffectBudget.cs" />
    <Compile Include="RecolorSplit.cs" />
    <Compile Include="ShaderWarm.cs" />
    <Compile Include="StartProbe.cs" />
    <Compile Include="PngDecoder.cs" />
    <Compile Include="ImagePrefetch.cs" />
    <Compile Include="TweenFix.cs" />
    <Compile Include="RenderWatch.cs" />
    <Compile Include="SamplerWatch.cs" />
    <Compile Include="RenderCallbackScan.cs" />
    <Compile Include="FrameRateScreenWatch.cs" />
    <Compile Include="ParticleTextWatch.cs" />
    <Compile Include="TextureCensus.cs" />
    <Compile Include="BootConfig.cs" />
  </ItemGroup>

  <PropertyGroup>
    <GameManaged>D:\SteamLibrary\steamapps\common\A Dance of Fire and Ice\A Dance of Fire and Ice_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule2" Condition="false" />
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(GameManaged)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManaged)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(GameManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RDTools">
      <HintPath>$(GameManaged)/RDTools.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(GameManaged)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityModManager">
      <HintPath>$(GameManaged)\UnityModManager\UnityModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)\UnityModManager\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>




